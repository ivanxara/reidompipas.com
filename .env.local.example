# Copy this file to .env.local and replace the values with your Supabase project keys.
# Never commit your real keys to version control.

# Public (client-side) Supabase URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-side (secret) key for privileged operations — keep this private
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
